{
  "name": "autoscript-ts",
  "version": "1.10.1",
  "private": true,
  "description": "AutoScript de Autofirma reescrito en TypeScript: SDK moderno tipado y autoscript.js compatible con el original",
  "keywords": [
    "afirma",
    "autofirma",
    "autoscript",
    "cades",
    "firma electronica",
    "pades",
    "typescript",
    "xades"
  ],
  "homepage": "https://github.com/cristiancastineiras/autoscript.ts#readme",
  "bugs": {
    "url": "https://github.com/cristiancastineiras/autoscript.ts/issues"
  },
  "license": "GPL-2.0-or-later OR EUPL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristiancastineiras/autoscript.ts.git"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/autoscript.js",
    "./dist/autoscript.min.js"
  ],
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/autoscript.min.js",
  "jsdelivr": "./dist/autoscript.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./autoscript.js": {
      "types": "./dist/autoscript.d.ts",
      "default": "./dist/autoscript.js"
    },
    "./autoscript.min.js": {
      "types": "./dist/autoscript.d.ts",
      "default": "./dist/autoscript.min.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "demo": "tsdown && node scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests bench scripts tsdown.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src tests bench scripts tsdown.config.ts vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node --test tests/package/*.test.mjs",
    "check:package": "publint --strict --pack npm",
    "check:types": "attw --pack --profile esm-only",
    "size": "node scripts/size.mjs && node scripts/treeshake.mjs",
    "bench": "vitest bench --run",
    "check": "node scripts/check.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "prepack": "tsdown",
    "release:tag": "changeset tag",
    "site": "node scripts/site.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "30.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.13.0"
}
