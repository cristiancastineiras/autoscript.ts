{
  "name": "autoscript-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Base modular TypeScript para modernizar Autoscript.js",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "encoding": [
        "./dist/encoding.d.ts"
      ],
      "browser": [
        "./dist/browser.d.ts"
      ],
      "websocket": [
        "./dist/websocket.d.ts"
      ],
      "https": [
        "./dist/https.d.ts"
      ],
      "intermediate": [
        "./dist/intermediate.d.ts"
      ],
      "compat": [
        "./dist/compat.d.ts"
      ],
      "compat/des": [
        "./dist/compat-des.d.ts"
      ],
      "ui": [
        "./dist/ui.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./encoding": {
      "import": {
        "types": "./dist/encoding.d.ts",
        "default": "./dist/encoding.js"
      },
      "require": {
        "types": "./dist/encoding.d.cts",
        "default": "./dist/encoding.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./websocket": {
      "import": {
        "types": "./dist/websocket.d.ts",
        "default": "./dist/websocket.js"
      },
      "require": {
        "types": "./dist/websocket.d.cts",
        "default": "./dist/websocket.cjs"
      }
    },
    "./https": {
      "import": {
        "types": "./dist/https.d.ts",
        "default": "./dist/https.js"
      },
      "require": {
        "types": "./dist/https.d.cts",
        "default": "./dist/https.cjs"
      }
    },
    "./intermediate": {
      "import": {
        "types": "./dist/intermediate.d.ts",
        "default": "./dist/intermediate.js"
      },
      "require": {
        "types": "./dist/intermediate.d.cts",
        "default": "./dist/intermediate.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./compat/des": {
      "import": {
        "types": "./dist/compat-des.d.ts",
        "default": "./dist/compat-des.js"
      },
      "require": {
        "types": "./dist/compat-des.d.cts",
        "default": "./dist/compat-des.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "demo": "npm run build && npm run demo:serve",
    "demo:serve": "node scripts/demo.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "oxlint --deny-warnings src tests bench scripts tsdown.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src tests bench scripts tsdown.config.ts vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node --test tests/package.test.mjs",
    "check:package": "publint",
    "check:types": "attw --pack",
    "check": "node scripts/check.mjs",
    "bench": "vitest bench --run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "des.js": "1.1.0",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "26.1.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "publint": "0.3.25",
    "rolldown": "1.2.13",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
