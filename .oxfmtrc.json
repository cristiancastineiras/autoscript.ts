{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "Estudio/**",
    "demo/**",
    "LICENSES/**",
    "dist/**",
    "site/**",
    "coverage/**",
    "node_modules/**",
    "pnpm-lock.yaml"
  ]
}
