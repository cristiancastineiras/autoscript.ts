{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/eqeqeq": "error",
    "eslint/no-underscore-dangle": [
      "warn",
      {
        "allow": ["__AUTOSCRIPT_VERSION__"]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "src/transports/*.ts",
        "src/core/client.ts",
        "tests/**/*.ts",
        "scripts/**/*.mjs",
        "bench/**/*.ts"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": ["Estudio/**", "dist/**", "coverage/**", "node_modules/**", "demo/**"]
}
